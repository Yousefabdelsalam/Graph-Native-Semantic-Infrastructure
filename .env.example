# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# Neo4j (used by docker-compose.yml and by the application)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-local-password
NEO4J_DATABASE=neo4j

# Integration tests run against the disposable test container.
NEO4J_TEST_URI=bolt://localhost:7688

# Optional: AI extraction and answer generation through OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Local embeddings (downloaded once, then offline).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Application paths and limits
DATA_DIR=./data
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO# Leave the key empty to run fully offline with pattern-based extraction.

